# Base URL the shared API client prefixes to every endpoint path.
# The API can pretend to be slow, broken or empty: put a switch before "/api".
VITE_API_BASE_URL=https://shopboard-api.vercel.app/api

# Loading state (answers after 3 seconds):
# VITE_API_BASE_URL=https://shopboard-api.vercel.app/delay/3000/api
# Error state (answers with status 500):
# VITE_API_BASE_URL=https://shopboard-api.vercel.app/fail/500/api
# Empty state (the product list is empty):
# VITE_API_BASE_URL=https://shopboard-api.vercel.app/empty/api
