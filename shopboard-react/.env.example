# Base URL the shared API client prefixes to every endpoint path.
# The API can pretend to be slow, broken or empty: put a switch before "/api".
# NEXT_PUBLIC_ variables are read at build time: restart `npm run dev` after changing it.
NEXT_PUBLIC_API_BASE_URL=https://shopboard-api.vercel.app/api

# Loading state (answers after 3 seconds):
# NEXT_PUBLIC_API_BASE_URL=https://shopboard-api.vercel.app/delay/3000/api
# Error state (answers with status 500):
# NEXT_PUBLIC_API_BASE_URL=https://shopboard-api.vercel.app/fail/500/api
# Empty state (the product list is empty):
# NEXT_PUBLIC_API_BASE_URL=https://shopboard-api.vercel.app/empty/api
