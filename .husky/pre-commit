# One hook for the whole repo. Run each project's own checks, only when its files are staged.
set -e

staged=$(git diff --cached --name-only)

if echo "$staged" | grep -q '^shopboard-vanilla/'; then
  echo "pre-commit: shopboard-vanilla"
  (cd shopboard-vanilla && npx lint-staged)
fi

if echo "$staged" | grep -q '^shopboard-react/'; then
  echo "pre-commit: shopboard-react"
  (
    cd shopboard-react
    npm run typecheck
    npm run lint
    npm run format:check
    npm run build
  )
fi
